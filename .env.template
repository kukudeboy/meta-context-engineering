# Copy this file to .env for the offline cluster (vLLM 0.8.5).
# Configuration priority: CLI arguments > exported environment > .env > defaults.
# 127.0.0.1 requires MCE and the model servers to run on the same node.
DASHSCOPE_API_BASE=http://127.0.0.1:8000/v1
DASHSCOPE_API_KEY=EMPTY

# For E2B Sandbox
E2B_API_KEY=YOUR_E2B_API_KEY

# === Local Cluster Robustness Settings ===
# Behavior profile: cluster_safe (default) or paper_compatible.
# paper_compatible restores the original tool/prompt/retry/statistics behavior
# where possible while still using the local OpenAI-compatible ToolAgent.
# To switch profiles, also set the explicit knobs below to the values listed
# in CLUSTER_RUN.md; explicit environment settings always take precedence.
MCE_BEHAVIOR_PROFILE=cluster_safe
# Model name for LLM calls (used by llm_client.py and workspace_utils/llm.py)
MCE_MODEL=llama-3.1-8b

# Embedding model name (used by workspace_utils/embedding.py and utils.py)
MCE_EMBEDDING_MODEL=qwen-embed
# Independent embedding service; omitted values fall back to DASHSCOPE_API_*.
MCE_EMBEDDING_API_BASE=http://127.0.0.1:8001/v1
MCE_EMBEDDING_API_KEY=EMPTY

# Concurrency control (prevent OOM on local GPU clusters)
MCE_MAX_CONCURRENCY=2
MCE_MAX_LLM_CONCURRENCY=2
MCE_MAX_LLM_CALLS=50

# LLM timeout in seconds (increase for slow local models)
MCE_LLM_TIMEOUT=300
# Bound inference and utility responses on the local model.
MCE_LLM_MAX_TOKENS=1024
# Explicit structured-output protocol, only used when a schema is supplied.
MCE_LLM_STRUCTURED_METHOD=function_calling

# Validation retry attempts (increase for weaker models)
MCE_MAX_VALIDATION_ATTEMPTS=5
MCE_AGENT_FINAL_FALLBACK=1
MCE_FORCE_WRITE_ONLY=1
MCE_METRICS_INCLUDE_ERRORS=1
# paper-compatible values: 3 / 0 / 0 / 0

# === Agent Loop (meta-agent / base-agent, OpenAI tool calling) ===
# The agent endpoint must support tool calling. For vLLM + Llama-3.1 start the server with:
#   --enable-auto-tool-choice --tool-call-parser llama3_json
#   --chat-template /path/to/mce/assets/tool_chat_template_llama3.1_json.jinja
# Model used by the agents (default: MCE_MODEL)
MCE_AGENT_MODEL=llama-3.1-8b
# Separate endpoint for the agents (default: DASHSCOPE_API_BASE / DASHSCOPE_API_KEY)
MCE_AGENT_API_BASE=http://127.0.0.1:8000/v1
MCE_AGENT_API_KEY=EMPTY

# Max model calls per agent query (one validation round)
MCE_AGENT_MAX_TURNS=40
# Max completion tokens per agent call (must fit into the server's --max-model-len)
MCE_AGENT_MAX_TOKENS=4096
# Prompt token budget; older history is elided/dropped beyond this.
# Keep MCE_AGENT_MAX_CONTEXT_TOKENS + MCE_AGENT_MAX_TOKENS below --max-model-len
# (e.g. 24000 + 4096 for --max-model-len 32768; 3500 + 2048 for 8192)
MCE_AGENT_MAX_CONTEXT_TOKENS=24000
# Max chars returned by a single tool call
MCE_AGENT_MAX_TOOL_OUTPUT=12000
MCE_AGENT_TEMPERATURE=0.2
# Seconds per agent model call
MCE_AGENT_TIMEOUT=600
# Allow the base-agent to run shell commands (1/0)
MCE_AGENT_ENABLE_BASH=1
